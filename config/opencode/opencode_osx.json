{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omlx-local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "Qwen3.5-122B-A10B-8bit": {
          "name": "Qwen3.5-122B-A10B-8bit",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "Qwen3.6-35B-A3B-8bit": {
          "name": "Qwen3.6-35B-A3B-8bit",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "Qwen3.6-35B-A3B-6bit": {
          "name": "Qwen3.6-35B-A3B-6bit",
          "limit": {
            "context": 256000,
            "output": 32768
          }
        },
        "gemma-4-26b-a4b-it-8bit": {
          "name": "gemma-4-26b-a4b-it-8bit",
          "limit": {
            "context": 256000,
            "output": 32768
          }
        },
        "gemma-4-31b-it-6bit": {
          "name": "gemma-4-31b-it-6bit",
          "limit": {
            "context": 256000,
            "output": 32768
          }
        }
      }
    },
    "zai": {
      "models": {
        "glm-5v-turbo": {
          "name": "GLM-5V-Turbo",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-5.2": {
          "name": "GLM-5.2",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "glm-4.6v": {
          "name": "GLM-4.6V",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "zai-coding-plan/glm-5.2",
  "small_model": "zai-coding-plan/glm-5.1",
  "permission": {
    "external_directory": {
      "~/projects/**": "allow",
      "~/git/**": "allow",
      "/tmp/**": "allow",
      "~/Desktop/pytower_data/logs/**": "allow"
    }
  },
  "mcp": {
    "unity": {
      "type": "local",
      "command": [
        "/Users/s1/.unity/relay/relay_mac_arm64.app/Contents/MacOS/relay_mac_arm64",
        "--mcp"
      ],
      "enabled": true
    },
    "zai-vision": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server@latest"],
      "enabled": true,
      "environment": {
        "Z_AI_API_KEY": "{file:~/.config/opencode/.zai_key}",
        "Z_AI_MODE": "ZAI"
      }
    }
  }
}
