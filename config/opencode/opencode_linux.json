{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omlx-local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "gemma-4-26b-a4b-it-8bit": {
          "name": "gemma-4-26b-a4b-it-8bit",
          "limit": {
            "context": 256000,
            "output": 32768
          }
        },
        "gemma-4-31b-it-6bit": {
          "name": "gemma-4-31b-it-6bit",
          "limit": {
            "context": 256000,
            "output": 32768
          }
        },
        "glm-5.1": {
          "name": "glm-5.1"
        },
        "glm-4.7": {
          "name": "glm-4.7"
        }
      }
    }
  },
  "model": "zai-coding-plan/glm-5.1",
  "small_model": "zai-coding-plan/glm-4.7",
  "permission": {
    "external_directory": {
      "~/projects/**": "allow",
      "~/git/**": "allow",
      "/tmp/**": "allow",
      "~/Desktop/pytower_data/logs/**": "allow"
    }
  },
  "mcp": {
    "unity": {
      "type": "local",
      "command": [
        "/home/f1/.unity/relay/relay_linux",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
