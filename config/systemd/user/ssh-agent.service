[Unit]
Description=SSH key agent (persistent, one instance per boot)

[Service]
Environment=SSH_AUTH_SOCK=%t/ssh-agent.sock
ExecStart=/usr/bin/ssh-agent -D -a %t/ssh-agent.sock
# leading "-" = non-fatal: a missing/bad key must not crash-loop the agent
-ExecStartPost=/usr/bin/ssh-add %h/.ssh/f_github
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
